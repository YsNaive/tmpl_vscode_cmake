{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build app",
            "type": "shell",
            "command": "cmake --build build --target MyPackageApp",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "package single file",
            "type": "shell",
            "command": "cmake --build build --target amalgamate",
            "group": "build",
            "problemMatcher": []
        }
    ]
}
